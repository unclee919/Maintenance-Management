 "format_data": [],
 "html": "<div class=\"print-format\">\n    <div style=\"text-align: center; margin-bottom: 20px;\">\n        <h2>Field Service Report & Work Order</h2>\n        <p><b>Request ID:</b> {{ doc.name }} | <b>Date:</b> {{ doc.get_formatted(\"creation\") }}</p>\n    </div>\n    <hr>\n    <table style=\"width: 100%; margin-bottom: 20px; font-size: 14px;\">\n        <tr>\n            <td><b>Customer Name:</b> {{ doc.customer_name }}</td>\n            <td><b>Status:</b> {{ doc.status }}</td>\n        </tr>\n        <tr>\n            <td><b>Phone:</b> {{ doc.customer_phone }}</td>\n            <td><b>Equipment:</b> {{ doc.equipment_type }}</td>\n        </tr>\n        <tr>\n            <td colspan=\"2\"><b>Service Address:</b> {{ doc.customer_address }}</td>\n        </tr>\n    </table>\n    <div style=\"margin-bottom: 20px; font-size: 14px;\">\n        <h4>Issue Description:</h4>\n        <p style=\"background: #f9f9f9; padding: 10px; border: 1px solid #ddd;\">{{ doc.issue_description or \"N/A\" }}</p>\n    </div>\n    <table style=\"width: 100%; margin-bottom: 20px; font-size: 14px;\">\n        <tr>\n            <td><b>Assigned Technician:</b> {{ doc.technician or \"Unassigned\" }}</td>\n            <td><b>Warranty Status:</b> {{ doc.warranty_status }}</td>\n        </tr>\n        <tr>\n            <td><b>Scheduled Date:</b> {{ doc.get_formatted(\"scheduled_date\") or \"N/A\" }}</td>\n            <td><b>Total Amount:</b> {{ doc.get_formatted(\"total_amount\") or \"$0.00\" }}</td>\n        </tr>\n    </table>\n    <div style=\"margin-top: 50px; display: flex; justify-content: space-between;\">\n        <div style=\"width: 40%; text-align: center; border-top: 1px solid #000; padding-top: 5px;\">Customer Signature</div>\n        <div style=\"width: 40%; text-align: center; border-top: 1px solid #000; padding-top: 5px;\">Technician Signature</div>\n    </div>\n</div>\n",
 "idx": 0,
