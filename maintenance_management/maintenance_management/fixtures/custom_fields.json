[
 {
  "doctype": "Custom Field",
  "name": "Sales Order-maintenance_tab",
  "dt": "Sales Order",
  "fieldname": "maintenance_tab",
  "fieldtype": "Tab Break",
  "insert_after": "more_info",
  "label": "Maintenance",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-maintenance_details_sb",
  "dt": "Sales Order",
  "fieldname": "maintenance_details_sb",
  "fieldtype": "Section Break",
  "insert_after": "maintenance_tab",
  "label": "General Order Maintenance Settings",
  "collapsible": 1,
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-custom_is_maintenance_order",
  "dt": "Sales Order",
  "fieldname": "custom_is_maintenance_order",
  "fieldtype": "Check",
  "insert_after": "maintenance_details_sb",
  "label": "Is Maintenance Order",
  "default": 1,
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-custom_is_emergency",
  "dt": "Sales Order",
  "fieldname": "custom_is_emergency",
  "fieldtype": "Check",
  "insert_after": "custom_is_maintenance_order",
  "label": "Emergency Dispatch",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-maintenance_item_section",
  "dt": "Sales Order Item",
  "fieldname": "maintenance_item_section",
  "fieldtype": "Section Break",
  "insert_after": "item_name",
  "label": "Service & Maintenance Details",
  "collapsible": 1,
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_technician",
  "dt": "Sales Order Item",
  "fieldname": "custom_technician",
  "fieldtype": "Link",
  "options": "Field Technician",
  "insert_after": "maintenance_item_section",
  "label": "Assigned Technician",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_status",
  "dt": "Sales Order Item",
  "fieldname": "custom_status",
  "fieldtype": "Select",
  "options": "New\nScheduled\nDispatched\nAccepted\nIn Progress\nCompleted\nCancelled",
  "default": "New",
  "insert_after": "custom_technician",
  "label": "Service Status",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_problem_description",
  "dt": "Sales Order Item",
  "fieldname": "custom_problem_description",
  "fieldtype": "Small Text",
  "insert_after": "custom_status",
  "label": "Problem Description",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_equipment_type",
  "dt": "Sales Order Item",
  "fieldname": "custom_equipment_type",
  "fieldtype": "Data",
  "insert_after": "custom_problem_description",
  "label": "Equipment Type",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_equipment_serial_no",
  "dt": "Sales Order Item",
  "fieldname": "custom_equipment_serial_no",
  "fieldtype": "Data",
  "insert_after": "custom_equipment_type",
  "label": "Equipment Serial No",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_scheduled_date_time",
  "dt": "Sales Order Item",
  "fieldname": "custom_scheduled_date_time",
  "fieldtype": "Datetime",
  "insert_after": "custom_equipment_serial_no",
  "label": "Scheduled Date & Time",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_sla_status",
  "dt": "Sales Order Item",
  "fieldname": "custom_sla_status",
  "fieldtype": "Select",
  "options": "On Time\nWarning\nBreached",
  "default": "On Time",
  "insert_after": "custom_scheduled_date_time",
  "label": "SLA Status",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_service_photo",
  "dt": "Sales Order Item",
  "fieldname": "custom_service_photo",
  "fieldtype": "Attach Image",
  "insert_after": "custom_sla_status",
  "label": "Service Completion Photo",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_customer_signature",
  "dt": "Sales Order Item",
  "fieldname": "custom_customer_signature",
  "fieldtype": "Signature",
  "insert_after": "custom_service_photo",
  "label": "Customer Signature",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order Item-custom_customer_rating",
  "dt": "Sales Order Item",
  "fieldname": "custom_customer_rating",
  "fieldtype": "Rating",
  "allow_on_submit": 1,
  "insert_after": "custom_customer_signature",
  "label": "Customer Rating",
  "module": "Maintenance Management"
 }
]
