  "label": "Service Completion Photo",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-assigned_technicians",
  "dt": "Sales Order",
  "fieldname": "assigned_technicians",
  "fieldtype": "Small Text",
  "insert_after": "service_photo",
  "label": "Assigned Technicians",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-is_warranty_claim",
  "dt": "Sales Order",
  "fieldname": "is_warranty_claim",
  "fieldtype": "Check",
  "insert_after": "assigned_technicians",
  "label": "Is Warranty Claim",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-original_order_ref",
  "dt": "Sales Order",
  "fieldname": "original_order_ref",
  "fieldtype": "Link",
  "options": "Sales Order",
  "insert_after": "is_warranty_claim",
  "label": "Original Order Reference",
  "module": "Maintenance Management"
 }
]
