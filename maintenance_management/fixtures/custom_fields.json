[
 {
  "doctype": "Custom Field",
  "name": "Sales Order-equipment_serial_no",
  "dt": "Sales Order",
  "fieldname": "equipment_serial_no",
  "fieldtype": "Data",
  "insert_after": "equipment_type",
  "label": "Equipment Serial No",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-sla_status",
  "dt": "Sales Order",
  "fieldname": "sla_status",
  "fieldtype": "Select",
  "insert_after": "scheduled_date_time",
  "label": "SLA Status",
  "options": "On Time\nWarning\nBreached",
  "default": "On Time",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-customer_signature",
  "dt": "Sales Order",
  "fieldname": "customer_signature",
  "fieldtype": "Signature",
  "insert_after": "sla_status",
  "label": "Customer Signature",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-service_photo",
  "dt": "Sales Order",
  "fieldname": "service_photo",
  "fieldtype": "Attach Image",
  "insert_after": "customer_signature",
  "label": "Service Completion Photo",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-assigned_technicians",
  "dt": "Sales Order",
  "fieldname": "assigned_technicians",
  "fieldtype": "Small Text",
  "insert_after": "service_photo",
  "label": "Assigned Technicians (Comma Separated)",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-is_warranty_claim",
  "dt": "Sales Order",
  "fieldname": "is_warranty_claim",
  "fieldtype": "Check",
  "insert_after": "assigned_technicians",
  "label": "Is Warranty Claim",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-original_order_ref",
  "dt": "Sales Order",
  "fieldname": "original_order_ref",
  "fieldtype": "Link",
  "options": "Sales Order",
  "insert_after": "is_warranty_claim",
  "label": "Original Order Reference",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Field Maintenance Settings-assignment_criteria",
  "dt": "Field Maintenance Settings",
  "fieldname": "assignment_criteria",
  "fieldtype": "Select",
  "insert_after": "auto_assign_technician",
  "label": "Assignment Criteria",
  "options": "Skill Based\nWorkload Balance\nTerritory Based\nRound Robin",
  "default": "Skill Based",
  "module": "Maintenance Management"
 },
 {
  "doctype": "Custom Field",
  "name": "Field Maintenance Settings-enable_health_check",
  "dt": "Field Maintenance Settings",
  "fieldname": "enable_health_check",
  "fieldtype": "Check",
  "insert_after": "assignment_criteria",
  "label": "Enable Automated Health Check & Monitoring",
  "default": 1,
  "module": "Maintenance Management"
 }
]
